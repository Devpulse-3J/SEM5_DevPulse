# Copy to `.env` in this same folder (infrastructure/docker/.env) and fill in.
# docker-compose.yml reads these. Never commit the real .env.

# --- Postgres (ONE shared database, used by every service) ---
POSTGRES_DB=devpulse
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=change-me

# --- RabbitMQ (guest/guest does NOT work across containers — set real creds) ---
RABBITMQ_USER=devpulse
RABBITMQ_PASSWORD=change-me

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- GitHub OAuth (Sign Up / Log In with GitHub) ---
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://odineye.cse23.org/auth/github/callback

# --- integration-service (optional until you connect GitHub/Jira) ---
GITHUB_WEBHOOK_SECRET=
# GitHub PAT with `repo` scope. Leave empty and api.github.com is called
# unauthenticated: 60 requests/hour, and private repos return 404 — which
# POST /projects/{id}/github/link surfaces as a 502.
GITHUB_API_TOKEN=
# GitHub App that grants repository access (separate from the sign-in OAuth App above).
# GITHUB_APP_NAME is the URL slug: github.com/apps/<slug>.
GITHUB_APP_ID=
GITHUB_APP_NAME=odineye-integrator-v2
# Single line: base64 -w0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY_BASE64=
JIRA_WEBHOOK_SECRET=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- notification-service (optional until you wire alerts) ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- analytics-service ---
RISK_THRESHOLD=0.7
