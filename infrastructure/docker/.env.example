# Copy to `.env` in this same folder (infrastructure/docker/.env) and fill in.
# docker-compose.yml reads these. Never commit the real .env.

# --- Postgres (ONE shared database, used by every service) ---
POSTGRES_DB=devpulse
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=change-me

# --- RabbitMQ (guest/guest does NOT work across containers — set real creds) ---
RABBITMQ_USER=devpulse
RABBITMQ_PASSWORD=change-me

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- integration-service (optional until you connect GitHub/Jira) ---
GITHUB_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- notification-service (optional until you wire alerts) ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- analytics-service ---
RISK_THRESHOLD=0.7
