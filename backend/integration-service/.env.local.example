SERVER_PORT=8082
# Single shared database. Schema is managed centrally by backend/database.
POSTGRES_URL=jdbc:postgresql://localhost:5432/devpulse
POSTGRES_USER=<placeholder>
POSTGRES_PASSWORD=<placeholder>
GITHUB_WEBHOOK_SECRET=<placeholder>
GITHUB_TOKEN=<placeholder>
GITHUB_API_TOKEN=<placeholder>
# GitHub App for repository access (not the sign-in OAuth App, which is GITHUB_CLIENT_ID in auth-service).
GITHUB_APP_ID=<placeholder>
GITHUB_APP_NAME=odineye-integrator-v2
# base64 -w0 of the App's .pem private key
GITHUB_APP_PRIVATE_KEY_BASE64=<placeholder>
JIRA_WEBHOOK_SECRET=<placeholder>
JIRA_BASE_URL=<placeholder>
JIRA_EMAIL=<placeholder>
JIRA_API_TOKEN=<placeholder>
RABBITMQ_URL=amqp://localhost:5672
# This service must NOT run migrations — the dedicated Flyway owner does.
SPRING_FLYWAY_ENABLED=false
