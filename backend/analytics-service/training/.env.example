# Copy this to .env and add your actual token
#
#     cp .env.example .env
#
# Create a token at https://github.com/settings/tokens
# A classic token with the "public_repo" scope is enough for public repos.
# Without a token GitHub allows only 60 requests/hour, which is far too few.
#
# NEVER put a real token in this file — it is committed to git.
# The real token belongs in .env, which is gitignored.
GITHUB_TOKEN=your_token_here
