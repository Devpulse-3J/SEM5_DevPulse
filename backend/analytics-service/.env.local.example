APP_PORT=8000
# Single shared database. Schema is managed centrally by backend/database.
# This service reads/writes ONLY pr_predictions and never runs migrations.
POSTGRES_URL=postgresql://localhost:5432/devpulse
POSTGRES_USER=<placeholder>
POSTGRES_PASSWORD=<placeholder>
RABBITMQ_URL=amqp://localhost:5672
# Serialised training bundle from training/train_snapshot_model.py.
# Copy it into app/artifacts/, or point this at training/stale_pr_model.pkl.
ANALYTICS_MODEL_PATH=./app/artifacts/stale_pr_model.pkl
# Set false to run the API without a broker (skips the pr.* consumer).
ENABLE_CONSUMER=true
RISK_THRESHOLD=0.7
