SERVER_PORT=8081
# Single shared database. Schema is managed centrally by backend/database.
POSTGRES_URL=jdbc:postgresql://localhost:5432/devpulse
POSTGRES_USER=<placeholder>
POSTGRES_PASSWORD=<placeholder>
JWT_SECRET=<placeholder>
JWT_EXPIRATION=3600
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
# This service must NOT run migrations — the dedicated Flyway owner does.
SPRING_FLYWAY_ENABLED=false
# GitHub OAuth App credentials for sign-up, login, and 1-click account connect (github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://odineye.cse23.org/auth/github/callback
